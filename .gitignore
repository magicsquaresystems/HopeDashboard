# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit only the example template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dev server transient log
dev-server.log

.playwright-mcp/

# Nothing under `local/` is committed.
#
# The cohort bundles used to be, via negations here, so the dashboard was
# self-contained on any host. That is not a trade worth making: the bundles
# hold real participant free-text from a health programme, and this repository
# is public. Obtain them out of band and drop them in — the app reads them
# from disk and does not care how they arrived.
local/*

# Ad-hoc Playwright screenshots and scratch
viewport-*.png
final-*.png
final2-*.png
cohort-*.png
hope-move dashboard.zip

# Project documentation is kept out of this repo: it is public, and the docs
# carry hosting costs, infrastructure detail and Space/model identifiers that
# should not be. INTEGRATION.md 1c also lists open security items against a
# live platform — an unprotected callback and a token that cannot be revoked —
# which is the last thing to publish while they are still open.
# They are maintained and shared with the team directly.
# Already-published copies remain in this repo's git history.
docs/

.claude/settings.local.json

# Local Playwright verification screenshots
/*.png
