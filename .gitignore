# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit only the example template)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dev server transient log
dev-server.log

.playwright-mcp/

# Nothing under `local/` is committed.
#
# The cohort bundles used to be, via negations here, so the dashboard was
# self-contained on any host. That is not a trade worth making: the bundles
# hold real participant free-text from a health programme, and this repository
# is public. Obtain them out of band and drop them in — the app reads them
# from disk and does not care how they arrived.
local/*

# Ad-hoc Playwright screenshots and scratch
viewport-*.png
final-*.png
final2-*.png
cohort-*.png
hope-move dashboard.zip

# The engineering handbook in docs/ is committed, and this repository is
# public, so it is written to carry no secrets, no participant data, no
# personal logins and no unresolved security findings. Those live in
# docs/private/, which is never committed and is shared with the team
# directly. Anything that would need a credential or a person's name to be
# useful belongs there, not in docs/.
docs/private/

.claude/settings.local.json

# Local Playwright verification screenshots
/*.png

# Firebase service-account keys — never commit. The repo is public and
# these grant access to a project holding participant-linked data.
*-firebase-adminsdk-*.json
serviceAccountKey.json
firebase-service-account*.json
