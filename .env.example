# Hope Facilitator dashboard env. Copy to .env (consumed by docker-compose
# and `next dev` alike).
#
# Two ways to point the dashboard at the backends — set COMMENT_GEN_URL /
# DROPOUT_API_URL accordingly:
#
#   1. Local compose stack (default below):
#        COMMENT_GEN_URL=http://localhost:8001
#        DROPOUT_API_URL=http://localhost:8000
#   2. Hosted private HF Spaces (production; also set HF_TOKEN):
#        COMMENT_GEN_URL=https://h4cdev-hope-comment-gen-api.hf.space
#        DROPOUT_API_URL=https://h4cdev-hope-dropout-api.hf.space

# ─── Shared HMAC secret (comment service) ──────────────────────────────
# Used by the comment service for X-HMAC-Signature verification, and by
# the dashboard's server-side proxy routes for signing. Must match the
# value the comment service runs with. Generate: openssl rand -hex 32
HOPE_API_SECRET=change-me

# Set to "disabled" for local dev / smoke tests; any other value enables
# strict HMAC checking on every signed endpoint.
HOPE_API_AUTH=disabled

# ─── Risk service (engagement_ml) ──────────────────────────────────────
# X-API-Key the dashboard sends to the risk service. Must match the
# API_KEY the service runs with. Generate: openssl rand -hex 32
HOPE_RISK_API_KEY=change-me

# ─── Hugging Face gateway ──────────────────────────────────────────────
# Read-scoped token from https://huggingface.co/settings/tokens.
# Required when the backends run as private HF Spaces (setup 2), and by
# the comment service to snapshot_download private adapters from the Hub.
HF_TOKEN=

# ─── Comment-generation service ────────────────────────────────────────
# Adapter to serve. Production pins the one below; the CPU-capable dev
# fallback is h4cdev/qwen3-0.6b-hope-forum-clean-lora (same corpus and
# behaviour contract, runs without a GPU).
HOPE_GEN_MODEL_ID=h4cdev/qwen3.5-4b-hope-forum-lora

# Set to "1" to short-circuit /generate and serve the safe deterministic
# stub (useful for UI work without a GPU on hand).
# HOPE_DISABLE_GENERATION=1

# Serve decodes from a vLLM server instead of loading weights in the comment
# service. Unset (default) = in-process transformers, which handles one decode
# at a time and refuses beyond HOPE_GEN_MAX_QUEUE; through vLLM, 20 concurrent
# drafts were all served. Start the optional service with
# `docker compose --profile vllm up` and set this to http://vllm:8000.
#
# vLLM needs a MERGED checkpoint — it cannot load the DoRA adapter. Build one
# with comment_generation/scripts/merge_adapter.py and name it in VLLM_MODEL.
# VLLM_BASE_URL=http://vllm:8000
# VLLM_MODEL=h4cdev/qwen3.5-4b-hope-forum

# Where comment-api probes the risk service for /health (compose uses the
# service-discovery name).
HOPE_DROPOUT_URL=http://risk-api:8000/health

# Where the engagement_reader looks for cumulative_features_panel.parquet.
# Optional — generation degrades gracefully (engagement_used: false) when
# the file is absent.
HOPE_DROPOUT_PANEL_PATH=/data/dropout_artifacts/cumulative_features_panel.parquet

# CORS allowlist on the comment-api side.
HOPE_DASHBOARD_ORIGIN=http://localhost:3000

# ─── Dashboard ─────────────────────────────────────────────────────────
# Server-side URLs the proxy routes use to reach the backends (see the
# two setups at the top of this file).
COMMENT_GEN_URL=http://localhost:8001
DROPOUT_API_URL=http://localhost:8000

# Public-facing variants for client components if needed (avoid where possible).
NEXT_PUBLIC_COMMENT_GEN_URL=http://localhost:8001
NEXT_PUBLIC_DROPOUT_API_URL=http://localhost:8000

# NextAuth v5. Generate AUTH_SECRET with: npx auth secret
# On Vercel, leave AUTH_URL unset (the platform provides the host).
#
# AUTH_SECRET is REQUIRED in production — without it every /api/auth/*
# route returns 500 ("There was a problem with the server configuration")
# and nobody can sign in at all.
AUTH_SECRET=change-me-dev-only
AUTH_URL=http://localhost:3000

# Sign-in is platform hand-off only — there is no email form and no
# direct-credentials provider. AUTH_MODE governs cohort VISIBILITY for
# facilitators with no explicit assignment: "open" shows every cohort
# (convenient for local dev), "allowlist" shows none until assigned
# (deny-by-default). PRODUCTION: set to "allowlist".
AUTH_MODE=open

# Which cohorts each facilitator may open, as JSON. Ignored when
# DATABASE_URL is set (the facilitator_cohorts table wins). When neither
# names an email: AUTH_MODE=open shows all cohorts, allowlist shows none.
# FACILITATOR_COHORTS={"alice@hope.org":[1680],"bob@hope.org":[1600,1651]}

# Postgres for shared triage state (snooze/dismiss/contacted) and cohort
# assignments. UNSET = JSON files under local/state/, which is fine for
# local dev but NOT for Vercel: serverless instances share no disk, so a
# deployment without this silently loses every snooze. Any provider's
# connection string works (Neon, Supabase, Azure, Railway).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Link back to the main Hope Move dashboard. Facilitators arrive here
# from there, so the cohort picker shows a "← Back to Hope Move" link
# when this is set, and hides it when it isn't.
# NEXT_PUBLIC_HOPE_MOVE_URL=https://app.hopemove.example/dashboard

# ─── Hope Move platform API (the production sign-in) ───────────────────
# Facilitators sign in on the Hope Move platform and are redirected to
# /auth/callback?code=<one-time>, which trades the code for an access +
# refresh token pair. The access token also authorises the dashboard's
# calls to the platform's own API, which is where the cohort list comes
# from once this is configured.
#
# Leave these unset to run on hand-off alone (see the next section) —
# that is the normal local setup, and the cohort registry then falls back
# to the hardcoded one in src/lib/cohorts.ts.
#
# HOPE_CLIENT_SECRET is a bearer credential: it alone lets the holder
# exchange codes and mint tokens for this client. Never commit a real
# value, never paste one into chat or a ticket, and rotate it if either
# happens.
# HOPE_API_URL=https://staging.poweredbyh4c.org
# HOPE_CLIENT_ID=hope-dashboard
# HOPE_CLIENT_SECRET=change-me

# ─── Platform hand-off (the original sign-in, still supported) ─────────
# The Hope Move platform links facilitators to
# /enter?token=<signed>&cohortId=<id> with a short-lived token carrying
# their identity, and this secret verifies the signature. It must match
# the value the platform signs with. Generate with:
#   openssl rand -hex 32
# Token format + a reference implementation: src/lib/auth/handoff.ts and
# scripts/mint-handoff-token.mjs (which also mints test links locally).
#
# A hand-off session grants access to the dashboard but carries no
# platform API credentials, so it cannot fetch cohorts from the platform.
HOPE_HANDOFF_SECRET=change-me

# For local development there is no platform to arrive from — mint a
# test hand-off link instead (requires HOPE_HANDOFF_SECRET above):
#   node scripts/mint-handoff-token.mjs
